{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-investment-public",
  "main": "./build/public-worker.ts",
  // Match the repository's pinned workerd/Vinext runtime; no dependency upgrade.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Domain assignment is a separate, owner-approved action after validation.
  "routes": [],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
